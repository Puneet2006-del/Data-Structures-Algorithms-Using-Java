int n = 10;
        int[] num = new int[n];
        // 0, 1, 1, 2, 3, 5, 8

//        When i = 2:
//        num[2] = num[1] + num[0] = 1 + 0 = 1
//
//        When i = 3:
//        num[3] = num[2] + num[1] = 1 + 1 = 2
//
//        When i = 4:
//        num[4] = num[3] + num[2] = 2 + 1 = 3
//
//        When i = 5:
//        num[5] = num[4] + num[3] = 3 + 2 = 5

        num[0] = 0;
        num[1] = 1;

        for (int i = 2; i < n; i++){
            num[i] = num[i - 1] + num[i - 2];
        }

        System.out.print("Fibonacci Sequence for the first 10 Numbers: ");
        for (int i = 0; i < n; i++){
            System.out.print(num[i] + " ");

        }
